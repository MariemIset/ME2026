# =========================================================================
# Churn ML — Environment Configuration
# Copy this file to `.env` and fill in real values. Never commit `.env`.
# =========================================================================

# --- PostgreSQL Data Warehouse ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=data_warehouse
DB_USER=admin
DB_PASSWORD=password123
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_CONNECT_RETRIES=5
DB_CONNECT_RETRY_BACKOFF=2.0

# --- Modeling windows ---
AS_OF_DATE=2017-12-31
OBSERVATION_WINDOW_MONTHS=12
PREDICTION_WINDOW_MONTHS=6
RANDOM_STATE=42

# --- MLflow ---
MLFLOW_TRACKING_URI=file:./mlruns
MLFLOW_EXPERIMENT_NAME=bo1_customer_churn

# --- Artifacts ---
ARTIFACT_DIR=./artifacts
MODEL_REGISTRY_DIR=./artifacts/models
REPORTS_DIR=./artifacts/reports
PREDICTIONS_TABLE=churn_predictions

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=json

# --- FastAPI ---
API_HOST=0.0.0.0
API_PORT=8000
API_MODEL_NAME=catboost_churn
