# =========================================================================
# Loyalty ML (BO2) — Environment Configuration
# Copy this file to `.env` and customise. Never commit `.env`.
# =========================================================================

# --- PostgreSQL Data Warehouse ---
DB_HOST=localhost
DB_PORT=5432
DB_NAME=data_warehouse
DB_USER=admin
DB_PASSWORD=password123
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_CONNECT_RETRIES=5
DB_CONNECT_RETRY_BACKOFF=2.0

# --- Modeling windows ---
AS_OF_DATE=2017-12-31
OBSERVATION_WINDOW_MONTHS=12
REDEMPTION_OUTCOME_WINDOW_MONTHS=3
UPLIFT_OUTCOME_WINDOW_MONTHS=6
RANDOM_STATE=42

# --- Segmentation ---
SEGMENTATION_MIN_K=2
SEGMENTATION_MAX_K=8

# --- MLflow ---
MLFLOW_TRACKING_URI=file:./mlruns
MLFLOW_EXPERIMENT_NAME=bo2_loyalty_optimization

# --- Artifacts ---
ARTIFACT_DIR=./artifacts
MODEL_REGISTRY_DIR=./artifacts/models
REPORTS_DIR=./artifacts/reports
RECOMMENDATIONS_TABLE=loyalty_recommendations

# --- Reward Catalog Profitability (CDN $; tunable without code change) ---
REWARD_BONUS_POINTS_MARGIN=15
REWARD_TIER_UPGRADE_MARGIN=40
REWARD_COMPANION_TICKET_MARGIN=120
REWARD_DOUBLE_POINTS_WEEKEND_MARGIN=10
REWARD_NO_OFFER_MARGIN=2

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=json

# --- FastAPI ---
API_HOST=0.0.0.0
API_PORT=8001
