# =========================================================================
# Streamlit UI for the Mission-Entreprise ML platform
# Copy this file to `.env` and edit if your APIs run elsewhere.
# =========================================================================

# --- Backend APIs ---
CHURN_API_URL=http://localhost:8000
LOYALTY_API_URL=http://localhost:8001

# --- HTTP behaviour ---
API_TIMEOUT_SECONDS=30
API_RETRY_ATTEMPTS=3
API_RETRY_BACKOFF=1.5

# --- Output sink (auto-created) ---
OUTPUT_DIR=./outputs

# --- Optional: local model paths for live SHAP ---
# If set, the UI can compute SHAP locally on the uploaded batch.
# Leave blank to disable the SHAP panel.
CHURN_LOCAL_MODEL_DIR=../churn_ml/artifacts/models
CHURN_LOCAL_MODEL_NAME=catboost_churn

# --- Logging ---
LOG_LEVEL=INFO
LOG_FORMAT=console

# --- Reproducibility ---
RANDOM_SEED=42
